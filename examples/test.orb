
manlo x = 10;


let y = 20;

bolo "--- Testing Math (BODMAS) ---";
bolo x + y * 2; 

bolo "--- Testing Logic (If/Else) ---";

agar (x) {
    bolo "Success: X ki value true hai!";
    
    manlo message = "Inside Block";
    bolo message;
} warna {
    bolo "Error: Kuch gadbad hai.";
}

bolo "--- Testing Complete ---";